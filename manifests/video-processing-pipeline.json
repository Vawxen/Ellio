# Video Processing Pipeline Manifest
# Uses actual agent implementations from agents/ directory

{
    "manifestVersion": "1.0.0",
    "workflowId": "video-processing-pipeline",
    "name": "Video Processing Pipeline",
    "description": "Complete video processing: ingest -> transcription -> translation -> subtitle generation",
    "parameters": {
        "input_video_path": "file:///input/video.mp4",
        "output_base_path": "file:///output",
        "target_language": "es"
    },
    "stages": [
        {
            "stageId": "ingest",
            "agentRole": "python agents/ingest-agent/main.py",
            "dependsOn": [],
            "inputs": [
                {
                    "artifactType": "video",
                    "artifactId": "source-video",
                    "version": "1.0.0",
                    "location": "{{input_video_path}}"
                }
            ],
            "outputs": [
                {
                    "artifactType": "video",
                    "artifactId": "ingested-video",
                    "version": "1.0.0",
                    "location": "{{output_base_path}}/ingested-video.mp4"
                }
            ],
            "qualityGates": [
                {
                    "gateId": "validate-input",
                    "type": "schemaValidation",
                    "config": {
                        "schemaUri": "schemas/video-artifact-v1.json"
                    }
                }
            ],
            "timeoutSeconds": 30,
            "retryPolicy": {
                "maxAttempts": 2,
                "backoffSeconds": 5
            }
        },
        {
            "stageId": "transcription",
            "agentRole": "python agents/transcription-agent/main.py",
            "dependsOn": ["ingest"],
            "inputs": [
                {
                    "artifactType": "video",
                    "artifactId": "ingested-video",
                    "version": "1.0.0",
                    "location": "{{output_base_path}}/ingested-video.mp4"
                }
            ],
            "outputs": [
                {
                    "artifactType": "transcript",
                    "artifactId": "video-transcript",
                    "version": "1.0.0",
                    "location": "{{output_base_path}}/transcript.json"
                }
            ],
            "qualityGates": [
                {
                    "gateId": "validate-transcript",
                    "type": "schemaValidation",
                    "config": {
                        "schemaUri": "schemas/transcript-artifact-v1.json"
                    }
                }
            ],
            "timeoutSeconds": 60
        },
        {
            "stageId": "translation",
            "agentRole": "python agents/translation-agent/main.py",
            "dependsOn": ["transcription"],
            "inputs": [
                {
                    "artifactType": "transcript",
                    "artifactId": "video-transcript",
                    "version": "1.0.0",
                    "location": "{{output_base_path}}/transcript.json"
                }
            ],
            "outputs": [
                {
                    "artifactType": "translated-transcript",
                    "artifactId": "translated-transcript",
                    "version": "1.0.0",
                    "location": "{{output_base_path}}/translated-transcript.json"
                }
            ],
            "qualityGates": [
                {
                    "gateId": "validate-translation",
                    "type": "schemaValidation",
                    "config": {
                        "schemaUri": "schemas/translated-transcript-artifact-v1.json"
                    }
                }
            ],
            "timeoutSeconds": 60
        },
        {
            "stageId": "subtitle-generation",
            "agentRole": "python agents/subtitle-generation-agent/main.py",
            "dependsOn": ["translation"],
            "inputs": [
                {
                    "artifactType": "translated-transcript",
                    "artifactId": "translated-transcript",
                    "version": "1.0.0",
                    "location": "{{output_base_path}}/translated-transcript.json"
                }
            ],
            "outputs": [
                {
                    "artifactType": "subtitles",
                    "artifactId": "video-subtitles",
                    "version": "1.0.0",
                    "location": "{{output_base_path}}/subtitles.srt"
                }
            ],
            "qualityGates": [
                {
                    "gateId": "validate-subtitles",
                    "type": "schemaValidation",
                    "config": {
                        "schemaUri": "schemas/subtitle-artifact-v1.json"
                    }
                }
            ]
        }
    ],
    "globalQualityGates": [
        {
            "gateId": "universal-artifact-check",
            "type": "schemaValidation",
            "config": {
                "schemaUri": "schemas/universal-artifact-v1.json"
            }
        }
    ]
}